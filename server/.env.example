# PostgreSQL (default matches docker-compose port 5433)
DATABASE_URL=postgresql://nca:nca@127.0.0.1:5433/nca_scanner

GEOSERVER_BASE=https://map.nca.by/geoserver/pcm/ows
# Optional dedicated WFS URL (default: same as GEOSERVER_BASE, i.e. …/ows)
# GEOSERVER_WFS_BASE=https://example.com/geoserver/workspace/wfs
GEOSERVER_REFERER=https://map.nca.by/

# WMS / WFS address layer (background scanner + live viewer)
WMS_ADDRESS_LAYER=pcm:841cf07c-b35f-4012-a364-000000000002
WFS_ADDRESS_TYPENAME=841cf07c-b35f-4012-a364-000000000002

# Background scanner: WFS sub-grid per tile (map.nca.by WMS GetFeatureInfo returns empty JSON for these layers)
SCANNER_WFS_SUBDIVIDE=4
# Quad-split parent tile if unique WFS features in tile >= this count
SCANNER_WFS_SATURATED_AT=2500

# WMS viewport (optional / viewer-only tuning)
WMS_WIDTH=512
WMS_HEIGHT=512
WMS_FEATURE_COUNT=50
WMS_GRID=8

# Initial scan tile size: edit SEED_TILE_STEP_* in src/scanner/belarus-regions.ts

# Politeness / rate limit (ms between upstream HTTP calls to map.nca.by)
REQUEST_DELAY_MS=800
HTTP_TIMEOUT_MS=45000

# Optional: 5-field cron (minute hour dom month dow). If set, overrides weekly spread / SCAN_INTERVAL_MS.
# Example: once per week Monday 03:00
# SCAN_CRON=0 3 * * 1
SCAN_CRON=
# When SCAN_CRON is empty: delay between ticks ≈ (SCAN_FULL_PASS_DAYS×24 h)×SCAN_TILES_PER_RUN / count(address scan_tiles).
# Set to false/0/off to use SCAN_INTERVAL_MS instead.
SCAN_USE_WEEKLY_SPREAD=true
# Target days for one full pass over all address tiles (default 14).
SCAN_FULL_PASS_DAYS=14
# Milliseconds between ticks when SCAN_CRON is empty and SCAN_USE_WEEKLY_SPREAD=false
SCAN_INTERVAL_MS=86400000
# Max quad-subdivision depth for saturated tiles
MAX_QUAD_DEPTH=12
# Tiles to process per tick (default 1 — very slow traversal)
SCAN_TILES_PER_RUN=1
# Re-scan a tile marked done after this many ms (default 14 days)
SCAN_RESCAN_AFTER_MS=1209600000

PORT=3000

# Viewer /viewer tile click → NCA WFS GetFeature (bbox + paging) + DB upsert
# Address WMS layer prefix is reused to qualify WFS typeNames (default registry id below)
# VIEWER_NCA_WMS_ADDRESS_LAYER=pcm:841cf07c-b35f-4012-a364-000000000002
# Optional WMS tuning (still used if you add a GFI fallback elsewhere)
# VIEWER_NCA_WMS_WIDTH=1280
# VIEWER_NCA_WMS_HEIGHT=1280
# VIEWER_NCA_FEATURE_COUNT=120
# VIEWER_NCA_WMS_ADDRESS_STYLES=pcm:841cf07c-b35f-4012-a364-000000000002_text
# VIEWER_NCA_SUBDIVIDE=4
# Reserved; live viewer WFS omits COUNT (NCA GeoServer errors on paged GetFeature)
# VIEWER_NCA_WFS_PAGE_SIZE=4000
# VIEWER_NCA_GRID=5
# VIEWER_NCA_REQUEST_DELAY_MS=90
